{
    "compilerOptions": {
        /* Language and Environment */
        "target": "es2022",
        "lib": [
            "es2022",
            "DOM",
            "DOM.ITerable"
        ],
        "jsx": "react-jsx",
        /* Modules */
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "resolveJsonModule": true,
        /* Emit */
        "rootDir": "./src",
        "outDir": "./lib",
        "declaration": true,
        /* Interop Constraints */
        "isolatedModules": true,
        "esModuleInterop": true,
        /* Type Checking */
        "strict": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
    },
    "include": [
        "src",
    ],
}